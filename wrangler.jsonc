{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "torus-engineering",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Navigation requests (Sec-Fetch-Mode: navigate) that miss an asset get
    // the 404 page without invoking the worker, so "/" must be routed to the
    // worker explicitly for the language redirect to run in real browsers.
    "run_worker_first": ["/"]
  }
}
